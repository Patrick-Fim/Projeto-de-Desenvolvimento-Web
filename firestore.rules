rules_version = '2';

// Regras de segurança do Protetores da Terra.
// O site é estático: o navegador fala direto com o Firestore, então é aqui
// que garantimos quem pode ler e gravar cada coisa.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // ---------- Perfis ----------
    match /usuarios/{uid} {
      // Perfis são públicos (ranking, membros). Não guardamos e-mail aqui.
      allow read: if true;

      // Cada pessoa só cria e altera o próprio perfil.
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.get('xp', 0) <= 5
        && !('email' in request.resource.data);

      // O XP só pode mudar aos poucos (no máximo +50 por vez), dificultando trapaça.
      allow update: if logado() && request.auth.uid == uid
        && request.resource.data.get('xp', 0) - resource.data.get('xp', 0) <= 50
        && request.resource.data.nome is string
        && request.resource.data.nome.size() <= 60
        && request.resource.data.get('bio', '').size() <= 160
        && !('email' in request.resource.data);
    }

    // ---------- Missões ----------
    match /missoes/{missao} {
      allow read: if true;

      // Quem cria vira o dono.
      allow create: if logado() && request.resource.data.creatorUid == request.auth.uid;

      // O dono edita o conteúdo (sem trocar o dono). Outros protetores só podem
      // mexer na lista de participantes e de quem concluiu (entrar/concluir).
      allow update: if logado() && (
        (resource.data.get('creatorUid', '') == request.auth.uid
          && request.resource.data.creatorUid == resource.data.creatorUid)
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['participantIds', 'participants', 'concluidoPor'])
      );

      // Só o dono exclui.
      allow delete: if logado() && resource.data.get('creatorUid', '') == request.auth.uid;

      function dadosMissao() {
        return get(/databases/$(database)/documents/missoes/$(missao)).data;
      }

      function ehMembro() {
        return logado() && (
          dadosMissao().get('creatorUid', '') == request.auth.uid
          || request.auth.uid in dadosMissao().get('participantIds', [])
        );
      }

      // Contato de quem denunciou (e-mail): só o dono da missão vê.
      match /contatos/{contato} {
        allow read, write: if logado() && dadosMissao().get('creatorUid', '') == request.auth.uid;
      }

      // Chat: só membros leem e escrevem; cada um só apaga a própria mensagem.
      match /mensagens/{mensagem} {
        allow read: if ehMembro();
        allow create: if ehMembro()
          && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.texto.size() <= 1000;
        allow update: if logado() && resource.data.autorUid == request.auth.uid;
      }
    }

    // ---------- Amizades ----------
    // Id = os dois uids em ordem, separados por "_". Só os dois envolvidos veem.
    match /amizades/{par} {
      allow read: if logado() && request.auth.uid in resource.data.usuarios;

      // Quem pede é o "de"; o pedido nasce pendente e com o id certo.
      allow create: if logado()
        && request.resource.data.de == request.auth.uid
        && request.resource.data.status == 'pendente'
        && request.resource.data.usuarios.size() == 2
        && request.auth.uid in request.resource.data.usuarios
        && request.resource.data.para in request.resource.data.usuarios
        && request.resource.data.para != request.auth.uid
        && par == request.resource.data.usuarios[0] + '_' + request.resource.data.usuarios[1];

      // Só quem recebeu pode aceitar.
      allow update: if logado()
        && resource.data.para == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'aceitaEm'])
        && request.resource.data.status == 'aceita';

      // Qualquer um dos dois pode recusar, cancelar ou desfazer.
      allow delete: if logado() && request.auth.uid in resource.data.usuarios;
    }

    // ---------- Conversas privadas (só entre amigos) ----------
    match /conversas/{par}/mensagens/{mensagem} {
      function saoAmigos() {
        return logado()
          && request.auth.uid in par.split('_')
          && get(/databases/$(database)/documents/amizades/$(par)).data.status == 'aceita';
      }
      allow read: if saoAmigos();
      allow create: if saoAmigos()
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.texto.size() <= 1000;
      allow update: if logado() && resource.data.autorUid == request.auth.uid;
    }

    // ---------- Chat do time (anel favorito) ----------
    match /times/{anel}/mensagens/{mensagem} {
      function doTime() {
        return logado()
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.anel == anel;
      }
      allow read: if doTime();
      allow create: if doTime()
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.texto.size() <= 1000;
      allow update: if logado() && resource.data.autorUid == request.auth.uid;
    }

    // ---------- Imagens (foto de perfil, banner, capa) ----------
    match /imagens/{imagem} {
      allow read: if true;
      allow create: if logado()
        && request.resource.data.donoUid == request.auth.uid
        && request.resource.data.dados.size() < 900000;
      allow delete: if logado() && resource.data.donoUid == request.auth.uid;
    }
  }
}
